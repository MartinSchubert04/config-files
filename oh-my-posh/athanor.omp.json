{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#FBB829",
          "style": "plain",
          "template": "@ ",
          "type": "text"
        },
        {
          "foreground": "#BAA67F",
          "style": "plain",
          "template": "{{ .UserName }}:",
          "type": "session"
        },
        {
          "foreground": "#FCE8C3",
          "options": {
            "folder_separator_icon": "/",
            "style": "full"
          },
          "style": "plain",
          "template": "<b>{{ .Path }}</b> ",
          "type": "path"
        },
        {
          "foreground": "#FBB829",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF5F00{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#0AAEB3{{ end }}",
            "{{ if gt .Ahead 0 }}#98BC37{{ end }}",
            "{{ if gt .Behind 0 }}#EF2F27{{ end }}"
          ],
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "plain",
          "template": "<#918175>on</> {{ .UpstreamIcon }} {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "foreground": "#519F50",
          "style": "plain",
          "template": " {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} ",
          "type": "python"
        },
        {
          "foreground": "#519F50",
          "style": "plain",
          "template": " {{ .Full }} ",
          "type": "node"
        },
        {
          "foreground": "#FBB829",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#EF2F27{{ end }}"
          ],
          "style": "plain",
          "template": "❯ ",
          "type": "text"
        }
      ],
      "type": "prompt"
    },
    {
      "segments": [
        {
          "foreground": "#EF2F27",
          "style": "plain",
          "template": "✗ {{ .Code }} ",
          "type": "status"
        },
        {
          "foreground": "#918175",
          "options": {
            "style": "round",
            "threshold": 2000
          },
          "style": "plain",
          "template": "{{ .FormattedMs }} ",
          "type": "executiontime"
        },
        {
          "foreground": "#918175",
          "options": {
            "time_format": "15:04"
          },
          "style": "plain",
          "template": "{{ .CurrentDate | date .Format }}",
          "type": "time"
        }
      ],
      "type": "rprompt"
    }
  ],
  "pwd": "osc7",
  "version": 4
}
